generator client {
  provider = "prisma-client-js"
  output   = "../generated/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

model user {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique(map: "User_email_key")
  password String
}
